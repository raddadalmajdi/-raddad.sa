{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "target": "eldres",
      "public": "eldres",
      "ignore": ["firebase.json", "**/.*"],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=3600" },
            { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
          ]
        }
      ]
    },
    {
      "target": "eigomedia",
      "public": "eigomedia",
      "ignore": ["firebase.json", "**/.*"],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=3600" },
            { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
          ]
        }
      ]
    }
  ]
}
