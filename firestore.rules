rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['raddad@raddad.sa'];
    }

    match /clients/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    function ticketCounterPeriod(p) {
      return p is string && p.matches('^[0-9]{4}-[0-9]{2}$');
    }

    function ticketCounterAdvance() {
      let prevPeriod = resource.data.get('period', '');
      let prevSeq = resource.data.get('seq', 0);
      return ticketCounterPeriod(request.resource.data.period)
        && request.resource.data.seq is int
        && request.resource.data.seq >= 1
        && request.resource.data.seq <= 9999
        && (
          (request.resource.data.period == prevPeriod
            && request.resource.data.seq == prevSeq + 1)
          || (request.resource.data.period != prevPeriod
            && request.resource.data.seq == 1)
        );
    }

    match /counters/tickets {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['period', 'seq'])
        && ticketCounterPeriod(request.resource.data.period)
        && request.resource.data.seq == 1;
      allow update: if request.auth != null && ticketCounterAdvance();
      allow delete: if false;
    }

    match /tickets/{ticketId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.priority in ['low', 'normal', 'high']
        && request.resource.data.status == 'open'
        && request.resource.data.publicId is string
        && request.resource.data.publicId.matches('^R-[0-9]{4}-[0-9]{2}-[0-9]{4}$')
        && request.resource.data.ticketPeriod is string
        && request.resource.data.ticketPeriod.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.ticketSeq is int
        && request.resource.data.ticketSeq >= 1
        && request.resource.data.ticketSeq <= 9999;

      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());

      allow update: if isAdmin()
        || (request.auth != null
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email);

      match /messages/{messageId} {
        function ticketDoc() {
          return get(/databases/$(database)/documents/tickets/$(ticketId)).data;
        }

        allow read: if request.auth != null
          && (isAdmin() || ticketDoc().uid == request.auth.uid);

        allow create: if request.auth != null
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000
          && request.resource.data.authorRole in ['admin', 'client']
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorEmail is string
          && (
            (isAdmin() && request.resource.data.authorRole == 'admin')
            || (ticketDoc().uid == request.auth.uid
              && request.resource.data.authorRole == 'client')
          );
      }
    }

    match /ideas/{ideaId} {
      allow create: if request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.description is string
        && request.resource.data.name.size() > 1
        && request.resource.data.email.matches('.*@.*\\..*')
        && request.resource.data.description.size() > 10;

      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
